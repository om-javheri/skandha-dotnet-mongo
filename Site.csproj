<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Site</RootNamespace>
    <AssemblyName>Site</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
  </ItemGroup>

  <!-- The site and its description are read from the project folder at run time, not compiled in. -->
  <ItemGroup>
    <Content Remove="site/**;server.json;data/**;client/**" />
    <None Remove="site/**;data/**;client/**" />
    <Compile Remove="client/**" />
  </ItemGroup>

</Project>
