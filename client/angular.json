{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "skandha-net-mongodb": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "uide",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": false,
            "tsConfig": "tsconfig.json",
            "styles": [
              "src/site.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "outputHashing": "none",
            "outputPath": {
              "base": "dist",
              "browser": ""
            }
          },
          "configurations": {
            "production": {},
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "skandha-net-mongodb:build:production"
            },
            "development": {
              "buildTarget": "skandha-net-mongodb:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
